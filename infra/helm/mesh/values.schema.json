{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "images",
    "runtimeSecret",
    "files",
    "publicOrigin"
  ],
  "properties": {
    "images": {
      "type": "object",
      "required": [
        "api",
        "web"
      ],
      "properties": {
        "api": {
          "type": "string",
          "pattern": "^[a-z0-9_.:/-]+@sha256:[a-f0-9]{64}$"
        },
        "web": {
          "type": "string",
          "pattern": "^[a-z0-9_.:/-]+@sha256:[a-f0-9]{64}$"
        }
      }
    },
    "runtimeSecret": {
      "type": "string",
      "minLength": 1
    },
    "migrationSecret": {
      "type": "string",
      "minLength": 1
    },
    "publicOrigin": {
      "type": "string",
      "pattern": "^https://[^/?#]+/?$"
    },
    "files": {
      "type": "object",
      "required": [
        "existingClaim"
      ],
      "properties": {
        "existingClaim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "externalDependencies": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cidr",
              "ports"
            ],
            "properties": {
              "cidr": {
                "type": "string",
                "pattern": "^(10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3})/32$"
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        }
      }
    }
  }
}
