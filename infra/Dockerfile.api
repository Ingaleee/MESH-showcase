FROM ruby:3.4-alpine3.23@sha256:ed7dfb6ccf31f54d33286eef060f611cfecbe03db3abffa37a999c0c7a9ba7a1 AS dependencies
WORKDIR /app
RUN apk upgrade --no-cache && apk add --no-cache build-base postgresql18-dev yaml-dev tzdata
ENV BUNDLE_PATH=/usr/local/bundle BUNDLE_WITHOUT=development:test BUNDLE_DEPLOYMENT=1
COPY apps/api/Gemfile apps/api/Gemfile.lock ./
RUN bundle install --jobs 4

FROM dependencies AS verification
ENV BUNDLE_WITHOUT="" RAILS_ENV=test
RUN bundle install --jobs 4
COPY apps/api/ ./
CMD ["bundle", "exec", "rspec"]

FROM dependencies AS build
COPY apps/api/ ./
COPY apps/gateway/ ./gateway/

FROM ruby:3.4-alpine3.23@sha256:ed7dfb6ccf31f54d33286eef060f611cfecbe03db3abffa37a999c0c7a9ba7a1
RUN apk upgrade --no-cache && apk add --no-cache libpq yaml curl postgresql18-client tzdata ca-certificates \
    && addgroup -g 10001 mesh && adduser -D -u 10001 -G mesh mesh
WORKDIR /app
ENV RAILS_ENV=production HOME=/tmp BUNDLE_PATH=/usr/local/bundle BUNDLE_WITHOUT=development:test BUNDLE_DEPLOYMENT=1
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /app /app
RUN mkdir -p tmp/pids tmp/cache log storage && chown -R mesh:mesh tmp log storage
USER mesh
EXPOSE 3000
CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "3000"]
