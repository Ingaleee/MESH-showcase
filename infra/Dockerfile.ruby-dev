FROM ruby:3.4-slim@sha256:976f45719573889b0ef02fcff5fd7a486cb09a56ad11c472d51d49604c31d6ab
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libpq-dev libyaml-dev git curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN gem install rails -v 8.1.4 --no-document
RUN curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/keyrings/postgresql.asc && echo "deb [signed-by=/usr/share/keyrings/postgresql.asc] https://apt.postgresql.org/pub/repos/apt trixie-pgdg main" > /etc/apt/sources.list.d/pgdg.list && apt-get update && apt-get install -y --no-install-recommends postgresql-client-18 && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
ENV BUNDLE_PATH=/usr/local/bundle
