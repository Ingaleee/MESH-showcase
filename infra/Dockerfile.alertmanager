FROM golang:1.27.1-alpine3.23@sha256:0908ac9b9319e09d7c238aabe914e0395c51d63c4e3d0ae8c554fda9158a5769 AS build
WORKDIR /src
ADD --checksum=sha256:2f6bce4f4b2b28aec4e58fad1341f47cde9c30adb556399472a8831942057941 https://github.com/prometheus/alertmanager/archive/refs/tags/v0.34.1.tar.gz /tmp/source.tar.gz
ADD --checksum=sha256:881fe0f7beb9573f35be47dd233af6220e72c8db72c03bcd1780402eb8dc1307 https://github.com/prometheus/alertmanager/releases/download/v0.34.1/alertmanager-web-ui-0.34.1.tar.gz /tmp/ui.tar.gz
RUN tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src \
    && tar -xzf /tmp/ui.tar.gz -C /src/ui/app
# Narrow temporary upstream dependency fix; remove when an official patched image ships.
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOMEMLIMIT=768MiB
RUN go get google.golang.org/grpc@v1.83.2 && go mod verify \
    && go build -p 1 -trimpath -ldflags="-s -w -X github.com/prometheus/common/version.Version=0.34.1+mesh.grpc1.83.2 -X github.com/prometheus/common/version.Revision=73c6bfe7393929211294c1954f30d8ed78e4d0ad" -o /out/alertmanager ./cmd/alertmanager \
    && go build -p 1 -trimpath -ldflags="-s -w" -o /out/amtool ./cmd/amtool
FROM prom/alertmanager:v0.34.1@sha256:e9733bafb1bdef9b00e25a21f8f99dc26a22224bf16641ad754d1649f4c3357a
COPY --from=build /out/alertmanager /bin/alertmanager
COPY --from=build /out/amtool /bin/amtool
LABEL org.opencontainers.image.revision="73c6bfe7393929211294c1954f30d8ed78e4d0ad" \
      mesh.showcase.dependency-patch="google.golang.org/grpc v1.83.1 -> v1.83.2"
